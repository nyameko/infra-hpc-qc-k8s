# Generated by reviewed Ansible. Do not publish externally.
[Unit]
Description=Axis H200 private GPU-pinned vLLM
Wants=network-online.target
After=network-online.target nvidia-cdi-refresh.service
RequiresMountsFor={{ axis_h200_vllm_model_cache }}
ConditionPathExists={{ axis_h200_vllm_env_file }}

[Container]
Image={{ axis_h200_vllm_image }}
ContainerName=h200-vllm
Pull=never
AddDevice=nvidia.com/gpu={{ axis_h200_vllm_gpu_uuid }}
SecurityLabelDisable=true
NoNewPrivileges=true
User={{ axis_h200_vllm_container_user }}
EnvironmentFile={{ axis_h200_vllm_env_file }}
Environment=HF_HOME=/home/vllm/.cache/huggingface
Volume={{ axis_h200_vllm_hf_cache }}:/home/vllm/.cache/huggingface
ShmSize=16g
PublishPort=127.0.0.1:{{ axis_h200_vllm_port }}:8000
Exec={{ axis_h200_vllm_model }} --tensor-parallel-size 1 --max-model-len {{ axis_h200_vllm_max_model_len }} --gpu-memory-utilization {{ axis_h200_vllm_gpu_memory_utilization }} --host 0.0.0.0 --port 8000

[Service]
Restart=on-failure
RestartSec=10
TimeoutStartSec=900
ExecStartPre=/usr/bin/findmnt -n --mountpoint {{ axis_h200_vllm_model_cache }}

[Install]
WantedBy=multi-user.target
