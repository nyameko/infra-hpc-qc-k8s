#!/usr/bin/env bash
set -euo pipefail

op="${1:-}"
arg="${2:-}"

valid_job() {
  [[ "$1" =~ ^[0-9]+([_][0-9]+)?$ ]]
}

case "$op" in
  submit)
    user="$arg"
    [[ "$user" =~ ^[a-z_][a-z0-9_-]*$ ]] || exit 64
    id "$user" >/dev/null 2>&1
    id -nG "$user" | tr ' ' '\n' | grep -Fxq "{{ jupyterhub_allowed_group }}" || {
      echo "user is not entitled to JupyterHub" >&2
      exit 77
    }

    tmp="$(mktemp /var/tmp/jhub-slurm.XXXXXX)"
    trap 'rm -f "$tmp"' EXIT
    cat >"$tmp"

    grep -Eq '^#SBATCH --job-name=jhub-' "$tmp" || exit 64
    grep -Eq '^#SBATCH --partition=(cpu-small|cpu-large)$' "$tmp" || exit 64
    grep -Eq '^#SBATCH --time=(02:00:00|08:00:00)$' "$tmp" || exit 64

    chown "$user":"$(id -gn "$user")" "$tmp"
    exec runuser -u "$user" -- /usr/bin/sbatch --parsable "$tmp"
    ;;

  history)
    # Query bounded accounting history for exactly one provisioned researcher.
    # This is a read-only forced-command operation; no shell or arbitrary flags.
    user="$arg"
    [[ "$user" =~ ^[a-z_][a-z0-9_-]*$ ]] || exit 64
    id "$user" >/dev/null 2>&1 || exit 77
    id -nG "$user" | tr ' ' '\n' | grep -Fxq "{{ jupyterhub_allowed_group }}" || {
      echo "research identity is not execution-entitled" >&2
      exit 77
    }
    # Use -X for one row per allocation, -u for server-side ownership,
    # and a 7-day window. Client cannot choose user, dates or sacct fields.
    /usr/bin/sacct -nP -X -u "$user" \
      -S "$(date -u -d '7 days ago' +%Y-%m-%d)" \
      --format=JobIDRaw,JobName%128,Partition%64,State,ExitCode,Elapsed,Submit,Start,End,NodeList%128 \
      | sort -t '|' -k7,7r | awk 'NR <= 75'
    ;;

  query)
    valid_job "$arg" || exit 64
    current="$(/usr/bin/squeue -h -j "$arg" -o '%T|%B' | head -n1)"
    if [[ -n "$current" ]]; then
      printf '%s\n' "$current"
      exit 0
    fi

    # Completed jobs leave squeue. Fall back to accounting so the platform can
    # persist terminal state after the notebook/workbench has disappeared.
    historical="$(/usr/bin/sacct -nP -X -j "$arg" --format=State,NodeList | awk 'NF {print; exit}')"
    [[ -n "$historical" ]] || exit 69
    printf '%s\n' "$historical"
    ;;

  cancel)
    # The portal sends username:UID:job-id from the authenticated user and
    # owner-filtered ExecutionRecord. Never accept an arbitrary browser name.
    # Even if this trusted service identity is compromised, Slurm itself
    # must make the final cancellation authorization as the research user.
    [[ "$arg" =~ ^([a-z_][a-z0-9_-]*):([0-9]+):([0-9]+([_][0-9]+)?)$ ]] || exit 64
    user="${BASH_REMATCH[1]}"
    expected_uid="${BASH_REMATCH[2]}"
    job="${BASH_REMATCH[3]}"

    # Forbid root, service accounts, and mismatched POSIX mappings.
    [[ "$expected_uid" =~ ^[0-9]{5,}$ ]] || exit 77
    actual_uid="$(id -u -- "$user")" || exit 77
    [[ "$actual_uid" == "$expected_uid" && "$actual_uid" -ge 20000 ]] || exit 77
    id -nG "$user" | tr ' ' '\n' | grep -Fxq "{{ jupyterhub_allowed_group }}" || exit 77

    # Defense in depth: do not rely on job-name prefixes for ownership.
    # This must match before delegating to Slurm's native permission check.
    job_owner="$(/usr/bin/squeue -h -j "$job" -o '%u' | head -n1)"
    [[ -n "$job_owner" && "$job_owner" == "$user" ]] || exit 77

    exec /usr/sbin/runuser -u "$user" -- /usr/bin/scancel -- "$job"
    ;;

  *)
    exit 64
    ;;
esac
