flush ruleset

table inet filter {
    chain input {
        type filter hook input priority filter;
        policy drop;

        iifname "lo" accept
        ct state established,related accept

        ip protocol icmp accept
        ip6 nexthdr icmpv6 accept

        # WG researcher access (51820) and the infrastructure fabric (51821).
        # Fabric peers use authenticated keys; keep the port accessible for roaming.
        udp dport { 51820, 51821 } accept

        tcp dport 22 ip saddr {{ bootstrap_ssh_cidr }} accept
        tcp dport 22 ip saddr {{ vpn_cidr }} accept

        udp dport 53 ip saddr { {{ mgmt_cidr }}, {{ k8s_cidr }}, {{ vpn_cidr }} } accept
        tcp dport 53 ip saddr { {{ mgmt_cidr }}, {{ k8s_cidr }}, {{ vpn_cidr }} } accept

        tcp dport { 80, 443 } ip saddr {{ vpn_cidr }} accept

        tcp dport { 1514, 1515, 55000 } ip saddr { {{ mgmt_cidr }}, {{ k8s_cidr }}, {{ vpn_cidr }} } accept

{% if edge_fabric_wazuh_cidrs | default([]) | length > 0 %}
        # Wazuh enrollment and agent transport only from authorized
        # federation sources; Wazuh API port 55000 stays private.
        iifname "wg-fabric" ip saddr { {{ edge_fabric_wazuh_cidrs | join(', ') }} } tcp dport { 1514, 1515 } accept
{% endif %}
    }

    chain forward {
        type filter hook forward priority filter;
        policy drop;

        ct state established,related accept

{% if edge_h200_slurm_forward_enabled | default(false) | bool %}
        # XD670 -> persistent Slurm controller. Separate from the researcher wg0.
        # No public TCP ingress. Routes, Neutron port security and reciprocal
        # controller reachability must be independently verified beforehand.
        iifname "wg-fabric" oifname "{{ ansible_facts.default_ipv4.interface }}" ip saddr {{ edge_h200_slurm_peer_ip }} ip daddr {{ edge_h200_slurm_controller_ip }} tcp dport 6817 accept
        # slurmctld -> XD670 slurmd. Keep other ports closed by default.
        iifname "{{ ansible_facts.default_ipv4.interface }}" oifname "wg-fabric" ip saddr {{ edge_h200_slurm_controller_ip }} ip daddr {{ edge_h200_slurm_peer_ip }} tcp dport 6818 accept
{% if edge_h200_slurm_diagnostic_icmp | default(false) | bool %}
        # Optional diagnostic probes; never required for Slurm operation.
        iifname "wg-fabric" oifname "{{ ansible_facts.default_ipv4.interface }}" ip saddr {{ edge_h200_slurm_peer_ip }} ip daddr {{ edge_h200_slurm_controller_ip }} ip protocol icmp icmp type echo-request accept
        iifname "{{ ansible_facts.default_ipv4.interface }}" oifname "wg-fabric" ip saddr {{ edge_h200_slurm_controller_ip }} ip daddr {{ edge_h200_slurm_peer_ip }} ip protocol icmp icmp type echo-request accept
{% endif %}
{% endif %}

        iifname "wg0" oifname "{{ ansible_facts.default_ipv4.interface }}" accept
        iifname "{{ ansible_facts.default_ipv4.interface }}" oifname "wg0" ct state established,related accept

        # Public web ingress:
        # OpenStack FIP → edge → HAProxy VIP
        iifname "{{ ansible_facts.default_ipv4.interface }}" oifname "{{ ansible_facts.default_ipv4.interface }}" ip daddr 10.51.0.100 tcp dport { 80, 443 } accept
    }

    chain output {
        type filter hook output priority filter;
        policy accept;
    }
}

table ip nat {
    chain prerouting {
        type nat hook prerouting priority dstnat; policy accept;

        iifname "{{ ansible_facts.default_ipv4.interface }}" ip daddr 10.50.0.10 tcp dport { 80, 443 } dnat to 10.51.0.100
    }

    chain postrouting {
        type nat hook postrouting priority srcnat;
        policy accept;

        ip saddr {{ vpn_cidr }} oifname "{{ ansible_facts.default_ipv4.interface }}" masquerade
        ip daddr 10.51.0.100 tcp dport { 80, 443 } oifname "{{ ansible_facts.default_ipv4.interface }}" snat to 10.50.0.10
    }
}
