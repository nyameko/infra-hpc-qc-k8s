[Unit]
Description=SCC26 authenticated student-only model API proxy
Requires=wg-quick@wg-students.service
After=network-online.target wg-quick@wg-students.service
Wants=vllm.service

[Service]
Type=simple
Restart=on-failure
RestartSec=5
ExecStartPre=/usr/sbin/nginx -t -c /etc/scc26-model-proxy/nginx.conf
ExecStart=/usr/sbin/nginx -c /etc/scc26-model-proxy/nginx.conf -g "daemon off;"
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
