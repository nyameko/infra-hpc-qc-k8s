[Unit]
Description=vLLM OpenAI-compatible model server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Restart=always
RestartSec=10
EnvironmentFile=/etc/vllm/vllm.env
ExecStartPre=-/usr/bin/podman rm -f vllm
ExecStart=/usr/bin/podman run --rm --name vllm --network host --ipc host --device nvidia.com/gpu=all -v {{ vllm_model_cache }}:/root/.cache/huggingface:Z {{ vllm_image }} --model {{ vllm_model }} --served-model-name {{ vllm_served_model_name }} --host 0.0.0.0 --port {{ vllm_port }} --dtype bfloat16 --gpu-memory-utilization {{ vllm_gpu_memory_utilization }} --max-model-len {{ vllm_max_model_len }} --api-key ${VLLM_BEARER_TOKEN}{% for arg in vllm_extra_args %} {{ arg }}{% endfor %}
ExecStop=/usr/bin/podman stop -t 30 vllm
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
